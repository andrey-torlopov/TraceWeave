# The operator CLI generates Compose environment from runtime/installation.json.
# You do not need to copy this file to .env. No credentials belong here.
TW_PUBLIC_ORIGIN=http://127.0.0.1:8080
TW_PORT=8080
TW_REGISTRATION_ENABLED=false
# HTTPS installation: bootstrap --origin https://research.example.org
# configure-mail stores SMTP URL/user/from in installation.json and reads its
# password from hidden TTY input into runtime/secrets/smtp_password.
